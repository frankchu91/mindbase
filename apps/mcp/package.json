{
  "name": "mindbase-mcp",
  "version": "0.1.2",
  "description": "MCP server for MindBase — query and write to your wiki from Claude Desktop, Cursor, Windsurf, Cline, or any MCP-compatible AI client.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mindbase-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli.ts",
    "test": "node test/full-smoke.mjs && node test/tools-call.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.10.0",
    "proper-lockfile": "^4.1.2",
    "rss-parser": "^3.13.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@mindbase/core": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mindbase",
    "knowledge-base",
    "claude",
    "cursor",
    "windsurf",
    "ai",
    "wiki",
    "karpathy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/frankchu91/mindbase",
    "directory": "apps/mcp"
  },
  "homepage": "https://github.com/frankchu91/mindbase#readme",
  "bugs": "https://github.com/frankchu91/mindbase/issues",
  "author": "Haobing Chu <haobing0304@gmail.com>",
  "license": "MIT",
  "mcpName": "io.github.frankchu91/mindbase"
}
