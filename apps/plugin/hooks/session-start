#!/usr/bin/env bash
# SessionStart hook for MindBase plugin.
# Reads current project's README + context + index.yaml, emits
# additionalContext JSON for Claude Code / Cursor / Copilot CLI.

set -euo pipefail

DATA_DIR="${MINDBASE_DATA_DIR:-${HOME}/mindbase-data}"
CONFIG_FILE="${DATA_DIR}/config.json"

# Locate current project id (jq-free, simple grep).
current_project=""
if [[ -f "${CONFIG_FILE}" ]]; then
  current_project="$(grep -o '"currentProjectId"[[:space:]]*:[[:space:]]*"[^"]*"' "${CONFIG_FILE}" \
    | sed -E 's/.*:[[:space:]]*"([^"]+)".*/\1/' || true)"
fi

# Build the context payload.
if [[ -z "${current_project}" ]]; then
  payload="MindBase plugin loaded. No current project selected. Run \`/mb:load <project-id>\` to switch projects, or \`/mb:init <name>\` to create one. Data dir: ${DATA_DIR}"
else
  project_dir="${DATA_DIR}/projects/${current_project}"
  if [[ ! -d "${project_dir}" ]]; then
    payload="MindBase plugin loaded. Current project '${current_project}' not found on disk. Run \`/mb:load\` to pick another, or \`/mb:init\` to scaffold."
  else
    readme="$(cat "${project_dir}/README.md" 2>/dev/null || echo '')"
    context="$(cat "${project_dir}/context.md" 2>/dev/null || echo '')"
    index_yaml="$(cat "${project_dir}/index.yaml" 2>/dev/null || echo '')"
    payload="<mindbase_project>
<project_id>${current_project}</project_id>
<data_dir>${DATA_DIR}</data_dir>

## README.md (operations manual)
${readme}

## context.md (curated truth — generated by /mb:build)
${context}

## index.yaml (auto-generated nav manifest)
\`\`\`yaml
${index_yaml}
\`\`\`

Tools available via the \`mindbase\` MCP server. Slash commands: /mb:contribute, /mb:build, /mb:ask, /mb:lint, /mb:status, /mb:research, /mb:daily-brief.
</mindbase_project>"
  fi
fi

# JSON-escape the payload.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}
payload_escaped="$(escape_for_json "$payload")"

# Emit per-harness JSON variant.
if [[ -n "${CURSOR_PLUGIN_ROOT:-}" ]]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$payload_escaped"
elif [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]] && [[ -z "${COPILOT_CLI:-}" ]]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$payload_escaped"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$payload_escaped"
fi

exit 0
