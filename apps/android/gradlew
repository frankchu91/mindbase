# NOTE: This gradlew script is the standard Gradle wrapper shell script.
# The gradle-wrapper.jar binary is NOT committed (see .gitignore).
# Run `gradle wrapper --gradle-version 8.7` after installing Gradle to generate it,
# OR open this project in Android Studio which will handle it automatically.
#

##############################################################################
# Helper Functions
##############################################################################

# Attempt to set APP_HOME
# Resolve links: $0 may be a link
APP_HOME=$( cd "${0%/*}" > /dev/null 2>&1 && pwd -P ) || exit

APP_NAME="Gradle"
APP_BASE_NAME="${0##*/}"

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
}

die () {
    echo
    echo "$*"
    echo
    exit 1
}

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java > /dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        # In POSIX sh, ulimit -H is undefined. That's why the general target
        # is target.
        # shellcheck disable=SC2039,SC3045
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
        ;;
    esac
    case $MAX_FD in  #(
      '' | soft) :;; #(
      *)
        # In POSIX sh, ulimit -n is undefined. That's why the general target
        # is target.
        # shellcheck disable=SC2039,SC3045
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

# Collect all arguments for the java command;
#   * $DEFAULT_JVM_OPTS, $JAVA_OPTS, and $GRADLE_OPTS can contain fragments of
#     shell script including quotes and variable substitutions, so put them in
#     double quotes to make sure that they are properly word-split and then
#     re-quoted as necessary;
#   * the remaining arguments are not allowed to contain shell fragments,
#     so we can drop the constraint: just put them in double quotes.

set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

# Stop when "xargs" is not available.
if ! command -v xargs > /dev/null 2>&1
then
    die "xargs is not available"
fi

# Use "xargs" to parse quoted args.
#
# With -n1 it outputs one arg per line, with the quotes and backslashes removed.
#
# In Bash we could simply do:
#
#   readarray ARGS < <( xargs -n1 <<<"$DEFAULT_JVM_OPTS" )
#
# but POSIX sh has neither arrays nor command substitution in the form of <(...)
#
# When a single arg contains a newline, it will be multiple "lines" in the
# output, and we can't distinguish them from multiple args. We don't support
# that.
#
# When a single arg contains a quoted embedded newline, e.g. -Dfoo="bar
# baz", then we need to handle that correctly, since it should be a single arg.
# xargs does handle this correctly.
#
# Note that if there are args with embedded spaces they will be "multiple"
# args to xargs but we handle that correctly since we use -n1.
eval "set -- $(
        printf '%s\n' "$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS" |
        xargs -n1 |
        sed ' s~[^a-zA-Z0-9/=@._-]~\\&~g; ' |
        tr '\n' ' '
    ) $*"

exec "$JAVACMD" "$@"
